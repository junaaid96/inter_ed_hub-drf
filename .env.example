# Copy to .env for local development. `neon deploy` / `neon env pull` fill in
# DATABASE_URL and the AWS_* values for the linked Neon branch.
DEBUG=true
SECRET_KEY=change-me
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Neon Postgres (omit to use a local SQLite file)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Neon Object Storage (omit to store uploads on local disk)
STORAGE_BUCKET=intered-hub-uploads
AWS_ENDPOINT_URL_S3=https://br-wandering-dew-b3dpbgob.storage.c-4.ap-southeast-1.aws.neon.tech
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1

# Optional SMTP; when set, new accounts must confirm their email
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
